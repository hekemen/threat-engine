# threat-engine environment file
#
# Copy to /etc/threat-engine/threat-engine.env and edit. Every setting below is
# optional; the defaults shown are what the daemon uses when a variable is
# unset or unparseable.

# Whether to attach the hostile DROP rules to raw:PREROUTING.
# Default: false. false means the ipset tables are still populated and /check
# and the metrics still work, but NO traffic is filtered. Unparseable values
# fall back to false.
ENFORCEMENT_ENABLED=false

# How often to poll the threat feeds, in minutes. Invalid or zero falls back
# to 5.
#INTERVAL_MINUTES=5

# Read-only listener for /healthz, /check, and /metrics.
#HTTP_PORT=9090

# Loopback-only admin listener that serves the enforcement toggle. It binds
# 127.0.0.1 exclusively, so it is never reachable off-host.
#ADMIN_PORT=9091

# Admin unix domain socket. This is the preferred control surface: it needs no
# port and can be restricted by filesystem permissions. The systemd unit
# creates /var/run/threat-engine automatically (RuntimeDirectory).
#ADMIN_SOCKET=/var/run/threat-engine/admin.sock

# Whether runtime enforcement toggles are refused. When ENFORCEMENT_ENABLED is
# present in this file, the environment owns the flag and the admin socket
# rejects changes with HTTP 403 — the operator changes the file and restarts.
#
# Set ENFORCEMENT_LOCK=false to keep the env var as the *initial* state only,
# so the toggle stays available at runtime.
#ENFORCEMENT_LOCK=true

# Name of the kernel ipset holding blocked IPs/CIDRs.
#HOSTILE_SET_NAME=threat_engine_hostile_ips

# Name of the kernel ipset holding allowed IPs/CIDRs.
#WHITELIST_SET_NAME=threat_engine_whitelist_ips

# Extra IPs/CIDRs to never block, comma-separated. RFC 1918 private ranges and
# link-local addresses are always excluded automatically and must not be listed
# here.
#WHITELIST=203.0.113.10,198.51.100.0/24

# Minimum score for confidence-weighted feeds such as IPsum.
#CONFIDENCE_THRESHOLD=3
